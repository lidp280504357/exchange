# 历史数据保留（M1，ADR-0022）：exchange-retention.timer 每日触发一次，见 docs/runbook/retention.md。
[Unit]
Description=Exchange history retention (exchangectl retention run under the ops lock)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/bin/bash /opt/exchange/infra/retention/retention.sh
# The lock may take an hour to come, the first large run some more (B199).
TimeoutStartSec=3h
# A stop signals the script alone, which stops the run's container and
# waits for it (docker stop -t 60); the rest is killed after (B201).
KillMode=mixed
TimeoutStopSec=2min
