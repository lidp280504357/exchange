# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。含特殊字符的值加双引号。
# 加载优先级（internal/platform/config）：代码默认值 < 本文件 < 进程环境变量；空值视为未设置。
# 本文件只供本地开发：进程环境变量 APP_ENV 为非 local 时不读取。

# 服务通用（internal/platform/app）。APP_ENV 必填：local | test | staging | prod
APP_ENV=local
# LOG_LEVEL=info        # debug | info | warn | error
# LOG_FORMAT=json       # json | text；不设时 local 用 text，其余用 json
# SHUTDOWN_TIMEOUT=10s  # 优雅退出总时限
# 监听地址用各服务代码里的默认值（api-gateway 为 :8080），不要写进共享的 .env；
# 临时覆盖：HTTP_ADDR=:18080 task run -- api-gateway
PUBLIC_DOMAIN=astras.vip

# Cloudflare Turnstile：站点密钥给前端，密钥只在服务端；HOSTNAMES 是 siteverify 返回 hostname 的允许列表
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES="astras.vip,m.astras.vip,localhost"

# auth-service。OTP_HMAC_KEY、JWT_SIGNING_KEY 用 `openssl rand -base64 32` 生成；本地可留空，
# 此时进程内随机生成，重启后验证码和令牌全部失效。其余变量不设时用代码默认值。
OTP_HMAC_KEY=
JWT_SIGNING_KEY=
JWT_KEY_ID=
# 加密身份验证器（TOTP）密钥的 AES-256 密钥，`openssl rand -base64 32` 生成；不设则无法绑定 TOTP。
# 换掉它会让已绑定的 TOTP 全部失效。
TOTP_SECRET_KEY=
# 非生产环境的端到端测试用它通过人机验证；生产环境禁止设置
CAPTCHA_BYPASS_TOKEN=
# TERMS_VERSION=2026-09-28             # 注册时必须接受的条款版本
# RISK_DISCLOSURE_VERSION=2026-09-28
# LOGIN_SILENCE=168h                   # 超过这么久无成功登录，密码正确后还要验证码（ADR-0009）
# ALLOWED_ORIGINS="https://astras.vip,https://m.astras.vip,http://localhost:5173,http://localhost:5174"  # 允许用 Cookie 刷新令牌的来源
# PASSWORD_HASH_CONCURRENCY=2          # 并发 Argon2id 计算数，每个占 64 MiB
# SMS_HOURLY_LIMIT=200                 # 全局短信额度，超出暂停短信
# SMS_DAILY_LIMIT=1000

# Resend 邮件
RESEND_API_KEY=
MAIL_FROM="Exchange <noreply@astras.vip>"

# 基础设施（开发模式为本地进程直连测试服）
POSTGRES_DSN="postgresql://exchange:<password>@3.107.113.199:5432/exchange?sslmode=disable"
REDIS_URL="redis://:<password>@3.107.113.199:6379/0"
KAFKA_BROKERS=3.107.113.199:9092
SCHEMA_REGISTRY_URL=http://3.107.113.199:8081
CLICKHOUSE_ADDR=3.107.113.199:9000
CLICKHOUSE_HTTP_URL=http://3.107.113.199:8123
CLICKHOUSE_DB=exchange
CLICKHOUSE_USER=exchange
CLICKHOUSE_PASSWORD=

# Grafana Cloud OTLP（见 docs/runbook/grafana-cloud.md）
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=exchange-local

# Alchemy Sepolia 测试网 RPC（阶段 2 钱包使用）。URL 里含 API key，日志与错误信息里从不出现。
# 本机开发栈（scripts/dev.sh）默认不扫链，DEV_SCAN=1 才用它。
ALCHEMY_SEPOLIA_HTTPS_URL=
ALCHEMY_SEPOLIA_WSS_URL=
ETH_CHAIN_ID=11155111
# wallet-service：充值账户的 xpub（`signer xpub` 打印，公钥，不能派生私钥），不设则不分配充值地址
# WALLET_XPUB=
# WALLET_NETWORK=ETH-SEPOLIA   WALLET_SCAN_INTERVAL=30s   WALLET_SCAN_START=0（0 表示从当前高度开始）
# signer 的 keystore 口令（SIGNER_PASSPHRASE）只在服务器 /opt/exchange/infra/signer/signer.env（见 docs/runbook/wallet.md），不放这里。
# signer serve 的限额（链上币种单位）：SIGNER_MAX_WITHDRAWAL=1  SIGNER_DAILY_WITHDRAWAL=5  SIGNER_MAX_FEE_GWEI=200  SIGNER_MAX_GAS=100000
# wallet-service 连签名服务与账本：SIGNER_GRPC_ADDR（不设则不发提现、不做归集与链上对账）、LEDGER_GRPC_ADDR、AUTH_GRPC_ADDR
# 提现：WALLET_WHITELIST_COOLDOWN=24h（新地址冷却期）  WALLET_MAX_FEE_GWEI=100（超过则等待）  WALLET_REPLACE_AFTER=10m（未上链则提价替换）
# 限额折算价格：MARKET_DATA_SERVICE_URL 的参考价，没有时用 WALLET_FALLBACK_PRICES="ETH:3000"
# 端到端充值测试（scripts/e2e/deposit.sh）的 Sepolia 发送方私钥，只有测试币；地址见 docs/runbook/wallet.md
E2E_SEPOLIA_SENDER_KEY=

# 托管钱包（优盾，ADR-0011，docs/runbook/custody.md）：wallet-service 与测试服的模拟网关 udun-mock 共用。
# UDUN_API_KEY 是请求与回调的签名密钥，只放本地 .env 与服务器 apps.env。不设 UDUN_GATEWAY_URL 则托管网络不能充提。
# 测试服：UDUN_GATEWAY_URL=http://udun-mock:8097  UDUN_CALLBACK_URL=http://api-gateway:8080/v1/wallet/callbacks/udun
# 真网关：UDUN_CALLBACK_URL=https://astras.vip/v1/wallet/callbacks/udun，UDUN_CALLBACK_ALLOWED_IPS 填托管方出口 IP（逗号分隔，可写 CIDR；空即不限来源、只靠签名）
UDUN_GATEWAY_URL=
UDUN_MERCHANT_ID=
UDUN_API_KEY=
UDUN_WALLET_ID=
UDUN_CALLBACK_URL=
UDUN_CALLBACK_ALLOWED_IPS=
# wallet-service 的托管方处理周期 WALLET_CUSTODY_INTERVAL=5s；模拟网关：UDUN_MOCK_ADDR=:8097  UDUN_MOCK_STATE=/data/state.json  UDUN_MOCK_STEP=2s  UDUN_MOCK_COINS（SYMBOL:MAIN:COIN:DECIMALS,...）

# 平台币模拟市场（market-sim，docs/runbook/market-sim.md）：管理接口的改动（参数、机器人、价格事件）要签名
#（internal/platform/svcsign），每个调用方一把密钥，各至少 32 个字符，`openssl rand -hex 32` 生成：
# SIM_API_SECRET（键名 ops）给 market-sim 容器里的 exchangectl sim；SIM_ADMIN_API_SECRET（键名 admin）给 admin-service，
# 只有它能填批准人。market-sim 两把都要。服务器上只在 /opt/exchange/infra/sim/{sim.env,admin.env}（部署脚本第一次运行时生成），不放 apps.env。
SIM_API_SECRET=
SIM_ADMIN_API_SECRET=
# MARKET_SIM_URL（exchangectl sim 用，默认 http://127.0.0.1:8098，即在 market-sim 容器里）

# 管理后台（admin-service、exchangectl admin create）：加密管理员 TOTP 密钥的 AES-256 密钥，`openssl rand -base64 32` 生成。
# 服务器上只在 /opt/exchange/infra/admin/admin.env（见 docs/runbook/admin.md），不放 apps.env；换掉它会让管理员的 TOTP 全部失效。
ADMIN_SECRET_KEY=
# admin-service 连各服务：AUTH_GRPC_ADDR、USER_GRPC_ADDR、LEDGER_GRPC_ADDR、INSTRUMENT_GRPC_ADDR、WALLET_SERVICE_URL、TRADING_SERVICE_URL

# 集成测试（task test:integration，internal/platform/testenv）：测试只在这些库里建随机 schema/key/topic 并自行清理
TEST_POSTGRES_DSN="postgresql://exchange:<password>@3.107.113.199:5432/exchange_test?sslmode=disable"
TEST_REDIS_URL="redis://:<password>@3.107.113.199:6379/15"
TEST_KAFKA_BROKERS=3.107.113.199:9092
TEST_SCHEMA_REGISTRY_URL=http://3.107.113.199:8081
TEST_CLICKHOUSE_ADDR=3.107.113.199:9000
TEST_CLICKHOUSE_USER=exchange
TEST_CLICKHOUSE_PASSWORD=
